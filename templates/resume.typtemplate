// GENERATED by jdossgollin/my-cv (scripts/generate_cv.py --resume) from the selection file next to this one.
// Edit the selection file or templates/resume.typtemplate in my-cv, not this file.

// Official Rice colors
#let rice-blue = rgb("#00205B") // use for text etc
#let rice-gray = rgb("#7C7E7F") // use for Section

#let mono(body) = text(font: "Inconsolata", body)
#let fa-solid(glyph) = text(font: "Font Awesome 7 Free Solid", glyph)
#let fa-brands(glyph) = text(font: "Font Awesome 7 Brands", glyph)
#let icon-envelope = fa-solid("\u{f0e0}")
#let icon-globe = fa-solid("\u{f0ac}")
#let icon-github = fa-brands("\u{f09b}")
#let icon-scholar = fa-brands("\u{e63b}")
#let icon-pin = fa-solid("\u{f3c5}")
#let icon-phone = fa-solid("\u{f095}")

// Header and footer (skip first page)
#let running(body) = context if here().page() > 1 { text(size: 8pt, fill: rice-gray, body) }
#set page(
  paper: "us-letter",
  margin: 0.75in,
  // Match fancyhdr: header rule 25pt above the text block, footer rule 20pt below it
  header-ascent: 25pt,
  footer-descent: 20pt,
  header: running[
    (((data.person.first_name))) (((data.person.last_name))) #h(1fr) (((resume.running_title | escape_typst)))
    #v(-0.2em)
    #line(length: 100%, stroke: 0.5pt + rice-gray)
  ],
  footer: running[
    #line(length: 100%, stroke: 0.5pt + rice-gray)
    #align(center, context counter(page).display("1 / 1", both: true))
  ],
)

#set text(font: "Lato", size: 10pt, lang: "en", region: "us")
#set par(justify: true, leading: 0.5em, spacing: 0.5em)
#show link: set text(fill: rice-blue)

// Section styling
#show heading.where(level: 1): it => block(above: 1.25em, below: 0.4em, sticky: true)[
  #text(size: 12pt, weight: "bold", upper(it.body))
  #v(-0.8em)
  #line(length: 100%, stroke: 0.4pt)
]
#show heading.where(level: 2): it => block(above: 1.25em, below: 0.5em, sticky: true,
  text(size: 10pt, weight: "bold", fill: rice-blue, upper(it.body)))

// One row: main content on the left with a hanging indent, date right-aligned.
// `indent` insets the whole row, for roles and degrees nested under an institution.
// par(hanging-indent:) does not reach a grid cell's paragraph, so the hang is built from padding.
#let entry(body, date, indent: 0pt, hang: 2em) = block(above: 0.5em, below: 0.5em, inset: (left: indent),
  grid(
    columns: (85%, 1fr),
    align: (left, right),
    pad(left: hang, h(-hang) + body), date,
  ))

// Group label within a subsection (e.g. advising roles)
#let group-label(name) = block(above: 1.1em, below: 0.7em, sticky: true, strong(name))

// Institution name above nested entries
#let institution(name) = block(above: 0.5em, below: 0.5em, sticky: true, strong(name))

// Plain-text note at the top of a section: its `note:` in the selection file, or a computed default
#let note(body) = block(below: 1em, emph(body))

// Highlighted author: bold for James; blue, bold, with a dagger for advisees
#let advisee(name) = text(fill: rice-blue, weight: "bold", name + super(typographic: false)[†])

//---------------------------------------------------------------------

((* macro authors(paper) *))((* for a in paper.authors *))((* if a.role == "self" *))#strong[(((a.name | escape_typst)))]((* elif a.role == "advisee" *))#advisee[(((a.name | escape_typst)))]((* else *))(((a.name | escape_typst)))((* endif *))((* if not loop.last *))((* if loop.length == 2 *)) and ((* elif loop.revindex == 2 *)), and ((* else *)), ((* endif *))((* endif *))((* endfor *))((* endmacro *))
((* macro award_lines(awards, dates) *))((* for a in awards *))
#entry(indent: 2em, hang: 0pt)[((* for t in a.titles *))#emph[(((t | escape_typst)))]((* if not loop.last *)) and ((* endif *))((* endfor *))((* if a.org *)), (((a.org | escape_typst)))((* endif *))][((* if dates *))(((a.years)))((* endif *))]
((* endfor *))((* endmacro *))

// Name and contact block, shared with the cover letter's letter.typ
#{
  // Fixed-width slot so the text right edges line up whatever the icon's width.
  let contact(body, icon) = [#body#h(0.45em)#box(width: 1.1em, align(center, icon))]
  set text(size: 9pt, fill: rice-gray)
  show link: set text(fill: rice-gray)
  set par(leading: 0.45em, justify: false)
  grid(
    columns: (1fr, auto),
    align: (left + horizon, right),
    text(size: 16pt, weight: "bold", fill: rice-blue)[(((data.person.first_name))) (((data.person.last_name)))],
    [
      #contact[(((resume.contact.location | escape_typst)))][#icon-pin] \
      #contact[(((resume.contact.phone | escape_typst)))][#icon-phone] \
      #contact(link("mailto:(((resume.contact.email)))")[(((resume.contact.email | escape_typst)))], icon-envelope) \
      #contact(link("(((data.person.web)))")[(((data.person.web | replace("https://", "") | escape_typst)))], icon-globe) \
      #contact(link("https://github.com/(((data.person.github)))")[(((data.person.github | escape_typst)))], icon-github) \
      #contact(link("https://scholar.google.com/citations?user=(((data.person.googlescholar)))")[(((data.person.first_name))) (((data.person.last_name)))], icon-scholar)
    ],
  )
}

